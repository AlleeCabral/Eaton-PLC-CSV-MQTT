        "type": "function",
        "z": "f8be77a225c75c64",
        "name": "UDP NetVar binary decoder",
        "func": "// UDP NetVar binary decoder -> msg.payload = { tags... }\n// Set endianness here:\nconst ENDIAN = \"LE\";          // \"LE\" or \"BE\"\nconst PACK_4BYTE = false;     // true if publisher aligns INTs to 4 bytes\n\n// ----- typed readers with LE/BE support -----\nfunction rBOOL(buf, off) {\n  if (off + 1 > buf.length) return [undefined, off];\n  return [buf.readUInt8(off) ? 1 : 0, off + 1];\n}\nfunction rINT(buf, off) {\n  if (off + 2 > buf.length) return [undefined, off];\n  const v = (ENDIAN === \"LE\") ? buf.readInt16LE(off) : buf.readInt16BE(off);\n  return [v, off + 2];\n}\nfunction rUDINT(buf, off) {\n  if (off + 4 > buf.length) return [undefined, off];\n  const v = (ENDIAN === \"LE\") ? buf.readUInt32LE(off) : buf.readUInt32BE(off);\n  return [v, off + 4];\n}\nfunction rREAL(buf, off) {\n  if (off + 4 > buf.length) return [undefined, off];\n  const v = (ENDIAN === \"LE\") ? buf.readFloatLE(off) : buf.readFloatBE(off);\n  return [v, off + 4];\n}\nfunction align4(off) { return PACK_4BYTE ? ((off + 3) & ~3) : off; }\n\n// ----- your exact spec (order matters) -----\nconst spec = [\n  [\"_11_Auto_Manual\",\"BOOL\"],\n  [\"_12_CIP_Switch\",\"BOOL\"],\n  [\"_13_Feed_Switch\",\"BOOL\"],\n  [\"_14_Booster_Switch\",\"BOOL\"],\n  [\"_15_Back_Wash_Switch\",\"BOOL\"],\n  [\"_16_Bohrhole_Switch\",\"BOOL\"],\n  [\"_17_Uv_Out_Switch\",\"BOOL\"],\n  [\"_18_Machine_Run\",\"BOOL\"],\n  [\"_19_CIPtank_High\",\"BOOL\"],\n  [\"_20_CIPtank_Low\",\"BOOL\"],\n  [\"_21_Anti_Scalant_Tank\",\"BOOL\"],\n  [\"_22_Raw_Water_Tank_High\",\"BOOL\"],\n  [\"_23_Raw_Water_Tank_Low\",\"BOOL\"],\n  [\"_24_Borhole_Float_Switch\",\"BOOL\"],\n  [\"_25_Premeate_Tank\",\"BOOL\"],\n  [\"_26_Grid_is_ON\",\"BOOL\"],\n  [\"_27_Alarm_Well_Level_Alarm\",\"BOOL\"],\n  [\"_28_Alarm_Feed_Inverter_Status_Alarm\",\"BOOL\"],\n  [\"_29_Alarm_Booster_Inverter_Status_Alarm\",\"BOOL\"],\n  [\"_30_Alarm_Bohrhole_Inverter_Status_Alarm\",\"BOOL\"],\n  [\"_31_Alarm_High_Pressure_Alarm\",\"BOOL\"],\n  [\"_32_Alarm_High_TDS_Alarm\",\"BOOL\"],\n  [\"_33_Alarm_Feed_Inverter_Temperature_Alarm\",\"BOOL\"],\n  [\"_34_Alarm_Booster_Inverter_Temperature_Alarm\",\"BOOL\"],\n  [\"_35_Alarm_Bohrhole_Inverter_Temperature_Alarm\",\"BOOL\"],\n  [\"_36_Alarm_UV_In_Lamp_Alarm\",\"BOOL\"],\n  [\"_37_Alarm_UV_Out_Lamp_Alarm\",\"BOOL\"],\n  [\"_38_Alarm_Anti_Scalant_Alarm\",\"BOOL\"],\n  [\"_39_Alarm_Flow_Meter_Alarm\",\"BOOL\"],\n  [\"_40_Alarm_Unstable_Voltage_Alarm\",\"BOOL\"],\n  [\"_41_AlarmRaw_Tank_Alarm\",\"BOOL\"],\n  [\"_42_Alarm_Valve_1_Alarm\",\"BOOL\"],\n  [\"_43_Alarm_Valve_2_Alarm\",\"BOOL\"],\n  [\"_44_Alarm_Valve_3_Alarm\",\"BOOL\"],\n  [\"_45_Alarm_Valve_4_Alarm\",\"BOOL\"],\n  [\"_46_Alarm_Valve_5_Alarm\",\"BOOL\"],\n  [\"_50_Solar_Power\",\"REAL\"],\n  [\"_51_Grid_Power\",\"REAL\"],\n  [\"_52_Total_Power\",\"REAL\"],\n  [\"_53_Feed_Power\",\"REAL\"],\n  [\"_54_Booster_Power\",\"REAL\"],\n  [\"_55_Pump_Power\",\"REAL\"],\n  [\"_56_Machine_Capacity\",\"REAL\"],\n  [\"_57_Machine_Grid_Percentage\",\"REAL\"],\n  [\"_58_Machine_Solar_Percentage\",\"REAL\"],\n  [\"_59_Alarm\",\"UDINT\"],\n  [\"_60_Total_Current\",\"REAL\"],\n  [\"_61_DC_Voltage_Feed\",\"INT\"],\n  [\"_62_DC_Voltage_Booster\",\"INT\"],\n  [\"_63_DC_Voltage_Pump\",\"INT\"],\n  [\"_64_Temperature_Inverter_Feed\",\"REAL\"],\n  [\"_65_Temperature_Inverter_Booster\",\"REAL\"],\n  [\"_66_Temperature_Inverter_Pump\",\"REAL\"],\n  [\"_67_Frequency_Inverter_Feed\",\"REAL\"],\n  [\"_68_Frequency_Inverter_Booster\",\"REAL\"],\n  [\"_69_Frequency_Inverter_Pump\",\"REAL\"],\n  [\"_70_Current_Inverter_Feed\",\"REAL\"],\n  [\"_71_Current_Inverter_Booster\",\"REAL\"],\n  [\"_72_Current_Inverter_Pump\",\"REAL\"],\n  [\"_73_Solar_Power_KWh_Total\",\"REAL\"],\n  [\"_74_Solar_Power_KWh_This_Hour\",\"REAL\"],\n  [\"_75_Solar_Power_KWh_Today\",\"REAL\"],\n  [\"_76_Solar_Power_KWh_This_Month\",\"REAL\"],\n  [\"_77_Grid_Power_KWh_Total\",\"REAL\"],\n  [\"_78_Grid_Power_KWh_This_Hour\",\"REAL\"],\n  [\"_79_Grid_Power_KWh_Today\",\"REAL\"],\n  [\"_80_Grid_Power_KWh_This_Month\",\"REAL\"],\n  [\"_81_Output_Power_KWh_Total\",\"REAL\"],\n  [\"_82_Output_Power_KWh_This_Hour\",\"REAL\"],\n  [\"_83_Output_Power_KWh_Today\",\"REAL\"],\n  [\"_84_Output_Power_KWh_This_Month\",\"REAL\"],\n  [\"_85_Raw_Water_M3_Total\",\"REAL\"],\n  [\"_86_Raw_Water_M3_This_Hour\",\"REAL\"],\n  [\"_87_Raw_Water_M3_Today\",\"REAL\"],\n  [\"_88_Raw_Water_M3_This_Month\",\"REAL\"],\n  [\"_89_Premeate_Water_M3_Total\",\"REAL\"],\n  [\"_90_Premeate_Water_M3_This_Hour\",\"REAL\"],\n  [\"_91_Premeate_Water_M3_Today\",\"REAL\"],\n  [\"_92_Premeate_Water_M3_This_Month\",\"REAL\"],\n  [\"_93_Current_Hour\",\"INT\"],\n  [\"_94_Current_Day\",\"INT\"],\n  [\"_95_Current_Month\",\"INT\"],\n  [\"_96_Current_Year\",\"INT\"],\n  [\"_97_Machine_Mode_Pro\",\"BOOL\"],\n  [\"_98_Machine_Mode_CIP\",\"BOOL\"],\n  [\"_99_Machine_Mode_Filling\",\"BOOL\"],\n  [\"_100_Machine_Mode_Flush\",\"BOOL\"],\n  [\"_101_Machine_Mode_Backwash\",\"BOOL\"],\n  [\"_102_Machine_Mode_Bohrhole\",\"BOOL\"],\n  [\"_105_Dosing_Pump_Alarm\",\"BOOL\"],\n  [\"_103_Datum_Backwash_Done\",\"BOOL\"],\n  [\"_104_Datum_CIP_Done\",\"BOOL\"],\n];\n\nif (!Buffer.isBuffer(msg.payload)) {\n  node.error(\"UDP decoder: expected Buffer payload\");\n  return null;\n}\n\nconst buf = msg.payload;\nlet off = 0;\nconst out = {};\n\nfor (const [name, type] of spec) {\n  let v;\n  if (type === \"BOOL\") {\n    [v, off] = rBOOL(buf, off);\n  } else if (type === \"INT\") {\n    [v, off] = rINT(buf, off);\n    off = align4(off); // only changes if PACK_4BYTE = true\n  } else if (type === \"UDINT\") {\n    [v, off] = rUDINT(buf, off);\n  } else if (type === \"REAL\") {\n    [v, off] = rREAL(buf, off);\n  } else {\n    node.error(\"Unknown type: \" + type);\n    return null;\n  }\n  if (v === undefined) {\n    node.error(`UDP decoder: buffer too short at ${name} (offset ${off})`);\n    return null;\n  }\n  out[name] = v;\n}\n\n// store + forward\nglobal.set(\"plc\", Object.assign(global.get(\"plc\") || {}, out));\nmsg.payload = out;\nreturn msg;\n",
