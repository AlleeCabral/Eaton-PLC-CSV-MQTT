        "id": "7a585f137127cca7",
        "type": "function",
        "z": "f8be77a225c75c64",
        "name": "size",
        "func": "// NetVar spec size calculator (per message / iteration)\n// Place after your netvar-receiver node (payload is {\"0\":[name,type,value], \"1\":[...], ...})\n\n// Toggle this if your publisher uses 4-byte packing/alignment\nconst PACK_4BYTE = false;         // true => align INTs to 4-byte boundaries\n\nfunction align4(n){ return PACK_4BYTE ? ((n + 3) & ~3) : n; }\n\nconst src = msg.payload;          // the triplets object\nif (typeof src !== \"object\" || src === null) {\n  node.warn(\"Expected triplet object from netvar-receiver\");\n  return msg;\n}\n\n// sizes\nconst SZ = { BOOL:1, INT:2, UDINT:4, DWORD:4, REAL:4 };\n\n// iterate in numeric order of indices\nconst keys = Object.keys(src).sort((a,b)=> Number(a)-Number(b));\n\nlet expected = 0;\nlet padding  = 0;\nconst counts = { BOOL:0, INT:0, UDINT:0, DWORD:0, REAL:0, OTHER:0 };\n\nfor (const k of keys) {\n  const triplet = src[k];\n  if (!Array.isArray(triplet) || triplet.length < 2) continue;\n  const name = triplet[0];\n  const type = (triplet[1] || \"\").toUpperCase().trim();\n\n  // align if needed (our observed pack rule: pad AFTER previous field when next is 2-byte INT)\n  if (PACK_4BYTE && type === \"INT\") {\n    const aligned = align4(expected);\n    if (aligned !== expected) {\n      padding += (aligned - expected);\n      expected  = aligned;\n    }\n  }\n\n  const sz = SZ[type] ?? null;\n  if (sz == null) {\n    counts.OTHER++;\n    node.warn(`Unknown type for ${name}: ${type} (counting as 0)`);\n    continue;\n  }\n\n  expected += sz;\n  if (counts[type] !== undefined) counts[type]++; else counts.OTHER++;\n}\n\n// decorate message for Debug\nmsg.netvar_spec = {\n  pack_4byte: PACK_4BYTE,\n  bytes: expected,\n  bits: expected * 8,\n  padding_bytes: padding,\n  counts\n};\n\n// nice one-liners for Debug node\nmsg.spec_len_bytes = expected;\nmsg.spec_len_bits  = expected * 8;\nmsg.spec_breakdown = `${counts.BOOL}xBOOL, ${counts.INT}xINT, ${counts.UDINT+counts.DWORD}xDWORD/UDINT, ${counts.REAL}xREAL, padding=${padding}B, pack4=${PACK_4BYTE}`;\n\nreturn msg;\n",
