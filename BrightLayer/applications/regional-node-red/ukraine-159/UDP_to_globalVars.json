    {
        "id": "864f32d6dacef02f",
        "type": "function",
        "z": "f8be77a225c75c64",
        "name": "Parse NetVar triplets",
        "func": "// Parse NetVar triplets -> one object keyed by the tag names.\n// Works with BOOL / INT / UDINT / DWORD / REAL; ignores order.\n\nconst toType = (v, t) => {\n  if (v === undefined || v === null) return undefined;\n  if (t === \"REAL\") return parseFloat(v);\n  if (t === \"BOOL\") return v ? 1 : 0;\n  if (t === \"INT\" || t === \"UDINT\" || t === \"DWORD\") return parseInt(v, 10);\n  return v;\n};\n\nconst plc = {};\nconst src = msg.payload;\nfor (const k in src) {\n  const triplet = src[k];\n  if (!Array.isArray(triplet) || triplet.length < 3) continue;\n  const [name, type, value] = triplet;\n  const cast = toType(value, type);\n  if (cast !== undefined && !Number.isNaN(cast)) plc[name] = cast;\n}\n\nconst merged = Object.assign(global.get(\"plc\") || {}, plc);\nglobal.set(\"plc\", merged);\nfor (const [k, v] of Object.entries(plc)) {\n    global.set(k, v);\n}\nmsg.payload = plc;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
