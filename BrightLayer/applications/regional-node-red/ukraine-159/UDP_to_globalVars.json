    {
        "id": "8d228149adaee740",
        "type": "function",
        "z": "f8be77a225c75c64",
        "name": "(OLD) Parse NetVar triplets",
        "func": "// Parse NetVar triplets -> one object keyed by the tag names.\n// Works with BOOL / INT / UDINT / DWORD / REAL; ignores order.\n\nconst toType = (v, t) => {\n  if (v === undefined || v === null) return undefined;\n  if (t === \"REAL\") return parseFloat(v);\n  // Treat BOOL/INT/UDINT/DWORD as integers (0/1 for BOOL)\n  if (t === \"BOOL\" || t === \"INT\" || t === \"UDINT\" || t === \"DWORD\") return parseInt(v, 10);\n  return v; // default passthrough\n};\n\nconst plc = {};\nconst src = msg.payload; // { \"0\":[name,type,value], \"1\":[...], ... }\nfor (const k in src) {\n  const triplet = src[k];\n  if (!Array.isArray(triplet) || triplet.length < 3) continue;\n  const [name, type, value] = triplet;\n  const cast = toType(value, type);\n  if (cast !== undefined && !Number.isNaN(cast)) plc[name] = cast;\n}\n\n// store and forward\nglobal.set(\"plc\", Object.assign(global.get(\"plc\") || {}, plc));\nmsg.payload = plc;   // handy for debug\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
